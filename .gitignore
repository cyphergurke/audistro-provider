vendor/
bin/
dist/

# Dependency directories
/pkg/

# Build artifacts
/audistro-provider
/audiprovider

# Local runtime state
data/provider.db
data/provider_identity.json

# IDE/editor files
.idea/
.vscode/
*.swp

# macOS
.DS_Store

# environment files
.env

# logs
*.log

# Kubernetes config or credentials
.kube/

# Coverage reports
coverage.out

# temp files
tmp/

# node modules if any
node_modules/
