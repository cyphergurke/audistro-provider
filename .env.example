# audistro-provider environment template

# Core
PROVIDER_HTTP_ADDR=:8080
PROVIDER_DATA_PATH=./data
PROVIDER_ASSETS_SUBDIR=assets
PROVIDER_IDENTITY_PATH=
PROVIDER_DB_PATH=
PROVIDER_SHUTDOWN_TIMEOUT_SECONDS=15

# Public/catalog/proxy
PROVIDER_PUBLIC_BASE_URL=
PROVIDER_ALLOW_INSECURE_PUBLIC_URL=false
PROVIDER_CATALOG_BASE_URL=
PROVIDER_CATALOG_TIMEOUT_SECONDS=10
PROVIDER_TRANSPORT=https
PROVIDER_STORAGE_MODE=filesystem
PROVIDER_ORIGIN_BASE_URL=
PROVIDER_ORIGIN_AUTH_MODE=none
PROVIDER_ORIGIN_HMAC_SECRET_PATH=
PROVIDER_ORIGIN_HMAC_KEY_ID=v1
PROVIDER_ORIGIN_AUTH_INCLUDE_QUERY=true
PROVIDER_PROXY_MAX_UPSTREAM_CONCURRENCY=64

# Asset serving and safety
PROVIDER_MAX_SEGMENT_BYTES=67108864
PROVIDER_RATE_LIMIT_RPS=20
PROVIDER_RATE_LIMIT_BURST=40
PROVIDER_ENFORCE_NO_SYMLINKS=true

# CORS (disabled by default)
PROVIDER_ENABLE_CORS=false
PROVIDER_CORS_ALLOWED_ORIGINS=
PROVIDER_CORS_ALLOW_CREDENTIALS=false

# Internal endpoints
PROVIDER_INTERNAL_ENABLE=true
PROVIDER_INTERNAL_ALLOWED_CIDRS=127.0.0.1/32,::1/128
PROVIDER_TRUST_PROXY_HEADERS=false
PROVIDER_TRUSTED_PROXY_CIDRS=

# Scanner/jobs
PROVIDER_SCAN_ON_STARTUP=true
PROVIDER_ENABLE_JOBS=true
PROVIDER_RESCAN_INTERVAL_SECONDS=300
PROVIDER_ANNOUNCE_SWEEP_INTERVAL_SECONDS=300
PROVIDER_REANNOUNCE_THRESHOLD_SECONDS=86400
PROVIDER_BACKOFF_BASE_MILLIS=2000
PROVIDER_BACKOFF_MAX_SECONDS=600
PROVIDER_REJECTED_RETRY_SECONDS=86400
PROVIDER_UNAUTHORIZED_RETRY_SECONDS=3600
PROVIDER_ANNOUNCEMENT_EXPIRY_GRACE_SECONDS=86400

# Announcements
PROVIDER_ANNOUNCE_PRIORITY=10
PROVIDER_ANNOUNCE_EXPIRES_SECONDS=604800

# Optional metadata / legacy fields
PROVIDER_REGION=
PROVIDER_PRIVATE_KEY_PATH=
PROVIDER_ANNOUNCE_INTERVAL=
