{
  "service": "audistro-provider",
  "keys": [
    { "key": "AUDISTRO_ENV", "required_in_prod": true, "pattern": "^(prod|dev|test)$", "redact": false },
    { "key": "PROVIDER_IDENTITY_PATH", "required_in_prod": true, "pattern": "^/.+", "redact": false },
    { "key": "PROVIDER_PUBLIC_BASE_URL", "required_in_prod": true, "pattern": "^https?://[^\\s]+$", "redact": false },
    { "key": "PROVIDER_CATALOG_BASE_URL", "required_in_prod": true, "pattern": "^https?://[^\\s]+$", "redact": false }
  ]
}
